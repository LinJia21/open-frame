# demo (default) serves prepared fixtures and does not call a model.
# cursor uses the Cursor Cloud Agents API. A missing key returns "not configured".
# It does not fall back to demo and it does not call xAI.
# grok is retired. See docs/CURSOR-PROVIDER.md.
ANALYSIS_PROVIDER=demo

# Server only. Never commit a real key, never put it in client code, and never log it.
# Leave this blank in the draft. Tests inject a mock transport and do not call Cursor.
CURSOR_API_KEY=

# Saved historical articles live in data/corpus/items.json (gitignored).
# The file starts empty. Import does not fetch URLs and does not call a paid news API.
# Charge guard. The real fetch transport stays off unless this is exactly 1.
# A present key with this unset returns network_disabled and sends nothing.
# CURSOR_ANALYSIS_ALLOW_NETWORK=

# Optional. Default https://api.cursor.com
# CURSOR_API_BASE=https://api.cursor.com

# Product pin. Defaults are required. Any other value is rejected and no other model is tried.
# CURSOR_AGENT_MODEL_ID=grok-4.5
# CURSOR_AGENT_EFFORT=medium
# CURSOR_AGENT_FAST=false

# CURSOR_ANALYSIS_TIMEOUT_MS=180000
# CURSOR_POLL_INTERVAL_MS=5000
